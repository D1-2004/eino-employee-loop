{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/D1-2004/eino-employee-loop/schema/event.schema.json",
  "title": "Event",
  "description": "The envelope of every employee input (event.Event).",
  "type": "object",
  "required": ["id", "source", "type", "scene", "actor", "occurred_at"],
  "properties": {
    "id": {"type": "string", "minLength": 1, "description": "Stable per producer; a replay carries the same content."},
    "source": {"type": "string", "minLength": 1, "description": "Producer namespace, for example chat.im."},
    "employee": {"type": "string", "description": "Addressed employee when a producer serves several."},
    "type": {"type": "string", "minLength": 1, "description": "Catalog type, for example message.addressed."},
    "class": {"enum": ["business", "execution", "completion", "schedule", "enablement"], "description": "Derived from the catalog."},
    "mode": {"enum": ["triggered", "listening"], "description": "Derived from the catalog."},
    "scene": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": {"type": "string", "description": "Host-minted scene id; the only key of per-scene state."},
        "kind": {"type": "string", "description": "group, dm, enterprise or a Host kind."},
        "tenant": {"type": "string"},
        "provider": {"type": "string"},
        "locator": {"type": "string", "description": "Provider identity for display and calls, never a state key."}
      },
      "additionalProperties": false
    },
    "actor": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": {"type": "string"},
        "kind": {"enum": ["human", "employee", "system", "integration"]},
        "display_name": {"type": "string"}
      },
      "additionalProperties": false
    },
    "occurred_at": {"type": "string", "format": "date-time"},
    "locale": {"type": "string"},
    "refs": {"type": "object", "additionalProperties": {"type": "string"}, "description": "task, run, routine, reply_to, ..."},
    "text": {"type": "string"},
    "payload": {"description": "Producer-specific data."}
  },
  "additionalProperties": false
}
