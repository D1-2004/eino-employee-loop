{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/D1-2004/eino-employee-loop/schema/defs.schema.json",
  "title": "Shared definitions",
  "description": "Values shared by the wire schemas of the Employee Loop service boundaries (package contract).",
  "$defs": {
    "Class": {
      "description": "What happened (contract.Class).",
      "type": "string",
      "enum": ["business", "execution", "completion", "schedule", "enablement"]
    },
    "Mode": {
      "description": "Why the employee received the event (contract.Mode): triggered = passive, listening = active.",
      "type": "string",
      "enum": ["triggered", "listening"]
    },
    "Lane": {
      "description": "Where an admitted event is processed (contract.Lane).",
      "type": "string",
      "enum": ["foreground", "background", "host"]
    },
    "SessionKind": {
      "description": "A session within a scene (contract.SessionKind). Hosts that register custom event types may use further kinds.",
      "type": "string",
      "minLength": 1,
      "examples": ["interactive", "observation", "follow_up", "routine", "lifecycle"]
    },
    "SceneRef": {
      "description": "The scene an event belongs to (contract.SceneRef). id is minted by the Host and is the only state key; locator is the opaque provider identity used for display and provider calls.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "kind": {"type": "string", "examples": ["group", "dm", "enterprise"]},
        "tenant": {"type": "string"},
        "provider": {"type": "string"},
        "locator": {"type": "string"}
      }
    },
    "MintedSceneRef": {
      "description": "A SceneRef that must carry a scene id.",
      "allOf": [
        {"$ref": "#/$defs/SceneRef"},
        {"required": ["id"], "properties": {"id": {"type": "string", "minLength": 1}}}
      ]
    },
    "Actor": {
      "description": "Who produced an event (contract.Actor). Supplied by the Host from authenticated data; display_name is data, not identity.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "kind": {"type": "string", "enum": ["", "human", "employee", "system", "integration"]},
        "display_name": {"type": "string"}
      }
    },
    "Requester": {
      "description": "An authenticated actor that must carry an id.",
      "allOf": [
        {"$ref": "#/$defs/Actor"},
        {"required": ["id"], "properties": {"id": {"type": "string", "minLength": 1}}}
      ]
    },
    "SessionRef": {
      "description": "One session within a scene (contract.SessionRef).",
      "type": "object",
      "additionalProperties": false,
      "required": ["scene", "kind"],
      "properties": {
        "scene": {"type": "string"},
        "kind": {"$ref": "#/$defs/SessionKind"},
        "key": {"type": "string"}
      }
    },
    "TaskStatus": {
      "description": "Task status (contract.TaskQueued ... contract.TaskCancelled).",
      "type": "string",
      "enum": ["queued", "running", "done", "failed", "cancelled"]
    },
    "DeliveryState": {
      "description": "Provider-facing lifecycle of a delivery (contract.DeliveryState).",
      "type": "string",
      "enum": ["pending", "unknown", "provider_accepted", "delivered", "failed", "suppressed"]
    },
    "Timestamp": {
      "description": "RFC 3339 time as encoded by Go's time.Time.",
      "type": "string",
      "format": "date-time"
    }
  }
}
