{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/D1-2004/eino-employee-loop/schema/task-view.schema.json",
  "title": "TaskView",
  "description": "The Task Manager's current view of a task (contract.TaskView), GET /v1/tasks/{ref}. report is evidence, not a delivery proof.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_ref",
    "employee",
    "scene",
    "requester",
    "source_ref",
    "goal",
    "status",
    "revision",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "task_ref": {
      "type": "string",
      "minLength": 1
    },
    "employee": {
      "type": "string",
      "minLength": 1
    },
    "scene": {
      "type": "string"
    },
    "requester": {
      "type": "string"
    },
    "source_ref": {
      "type": "string"
    },
    "goal": {
      "type": "string"
    },
    "status": {
      "$ref": "defs.schema.json#/$defs/TaskStatus"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "report": {
      "type": "string"
    },
    "failure": {
      "type": "string"
    },
    "created_at": {
      "$ref": "defs.schema.json#/$defs/Timestamp"
    },
    "updated_at": {
      "$ref": "defs.schema.json#/$defs/Timestamp"
    }
  }
}
