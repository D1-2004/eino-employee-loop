{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/D1-2004/eino-employee-loop/schema/tool-spec.schema.json",
  "title": "ToolSpec",
  "description": "The Host-supplied contract of one model-visible tool (contract.ToolSpec), as in contract/catalog/tools.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "kind",
    "parameters"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "read",
        "effect",
        "terminal"
      ]
    },
    "description": {
      "type": "string",
      "description": "Model-facing text; catalog specs leave it empty and set description_key."
    },
    "description_key": {
      "type": "string",
      "description": "i18n key of the description."
    },
    "parameters": {
      "type": "object",
      "description": "JSON Schema of the arguments."
    },
    "terminal": {
      "type": "string",
      "enum": [
        "reply",
        "quiet",
        "dispatched",
        "waiting"
      ]
    },
    "exclusive": {
      "type": "boolean",
      "description": "Must be the only call in its batch."
    },
    "lanes": {
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/Lane"
      }
    },
    "sessions": {
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/SessionKind"
      }
    },
    "ports": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "timeout": {
      "type": "integer",
      "minimum": 0,
      "description": "Bound of one execution in nanoseconds (Go time.Duration); 0 uses the kernel default."
    }
  },
  "anyOf": [
    {
      "required": [
        "description"
      ]
    },
    {
      "required": [
        "description_key"
      ]
    }
  ]
}
