{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/D1-2004/eino-employee-loop/schema/delivery.schema.json",
  "title": "Delivery",
  "description": "One outbound message produced by a window (contract.Delivery). Sent to POST /v1/deliveries. id is idempotent per window and purpose, for example <window>/reply.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "employee",
    "scene",
    "session",
    "window_id",
    "text",
    "state"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "employee": {
      "type": "string",
      "minLength": 1
    },
    "scene": {
      "$ref": "defs.schema.json#/$defs/SceneRef"
    },
    "session": {
      "$ref": "defs.schema.json#/$defs/SessionRef"
    },
    "window_id": {
      "type": "string",
      "minLength": 1
    },
    "reply_to": {
      "type": "string",
      "description": "Event id the delivery answers (foreground windows)."
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "locale": {
      "type": "string"
    },
    "state": {
      "$ref": "defs.schema.json#/$defs/DeliveryState"
    },
    "provider_id": {
      "type": "string",
      "description": "Provider message id once known."
    },
    "created_at": {
      "$ref": "defs.schema.json#/$defs/Timestamp"
    },
    "updated_at": {
      "$ref": "defs.schema.json#/$defs/Timestamp"
    }
  }
}
