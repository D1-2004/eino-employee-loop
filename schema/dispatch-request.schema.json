{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/D1-2004/eino-employee-loop/schema/dispatch-request.schema.json",
  "title": "DispatchRequest",
  "description": "Asks the Task Manager to create background work (contract.DispatchRequest), POST /v1/tasks. The loop derives idempotency_key from the window, the model turn and the native tool call id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "idempotency_key",
    "employee",
    "scene",
    "requester"
  ],
  "properties": {
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "employee": {
      "type": "string",
      "minLength": 1
    },
    "tenant": {
      "type": "string"
    },
    "scene": {
      "$ref": "defs.schema.json#/$defs/MintedSceneRef"
    },
    "requester": {
      "$ref": "defs.schema.json#/$defs/Requester"
    },
    "source_ref": {
      "type": "string",
      "description": "Event id the request came from."
    },
    "goal": {
      "type": "string"
    },
    "prompt": {
      "type": "string"
    },
    "locale": {
      "type": "string"
    }
  },
  "anyOf": [
    {
      "required": [
        "goal"
      ],
      "properties": {
        "goal": {
          "minLength": 1
        }
      }
    },
    {
      "required": [
        "prompt"
      ],
      "properties": {
        "prompt": {
          "minLength": 1
        }
      }
    }
  ]
}
