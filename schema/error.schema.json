{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/D1-2004/eino-employee-loop/schema/error.schema.json",
  "title": "Error",
  "description": "Wire form of an error on every HTTP boundary (httpapi.ErrorBody). Each code maps to one sentinel error.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "message"
  ],
  "properties": {
    "code": {
      "type": "string",
      "enum": [
        "invalid_event",
        "unknown_type",
        "unknown_scene",
        "unknown_employee",
        "invalid_request",
        "delivery_rejected",
        "bad_request",
        "unauthorized",
        "forbidden",
        "not_found",
        "conflict",
        "task_state",
        "stale_revision",
        "lease",
        "too_large",
        "quota",
        "unavailable",
        "internal"
      ]
    },
    "message": {
      "type": "string",
      "description": "Diagnostic text for operators, not for end users."
    }
  }
}
