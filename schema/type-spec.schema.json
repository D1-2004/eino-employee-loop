{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/D1-2004/eino-employee-loop/schema/type-spec.schema.json",
  "title": "TypeSpec",
  "description": "The routing contract of one event type (contract.TypeSpec), as in contract/catalog/events.json and contract.Catalog.Register.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "class",
    "mode",
    "lane",
    "requires_scene",
    "summary_key"
  ],
  "properties": {
    "type": {
      "type": "string",
      "minLength": 1
    },
    "class": {
      "$ref": "defs.schema.json#/$defs/Class"
    },
    "mode": {
      "$ref": "defs.schema.json#/$defs/Mode"
    },
    "lane": {
      "$ref": "defs.schema.json#/$defs/Lane"
    },
    "session": {
      "$ref": "defs.schema.json#/$defs/SessionKind"
    },
    "session_key": {
      "type": "string",
      "description": "Refs key that partitions the session."
    },
    "requires_scene": {
      "type": "boolean"
    },
    "preemptible": {
      "type": "boolean"
    },
    "preempts": {
      "type": "boolean"
    },
    "revokes": {
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/SessionKind"
      }
    },
    "coalesce": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quiet_ms",
        "max_wait_ms",
        "max_items"
      ],
      "properties": {
        "quiet_ms": {
          "type": "integer",
          "minimum": 0
        },
        "max_wait_ms": {
          "type": "integer",
          "minimum": 0
        },
        "max_items": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "summary_key": {
      "type": "string",
      "minLength": 1
    }
  }
}
