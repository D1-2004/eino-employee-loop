{
  "version": 1,
  "types": [
    {"type": "plan.step_completed", "class": "completion", "mode": "triggered", "lane": "background", "session": "follow_up", "session_key": "task", "requires_scene": true, "summary_key": "hostext.event.plan.step_completed"},
    {"type": "collection.ready", "class": "completion", "mode": "triggered", "lane": "background", "session": "follow_up", "session_key": "task", "requires_scene": true, "summary_key": "hostext.event.collection.ready"},
    {"type": "task.reminder", "class": "schedule", "mode": "listening", "lane": "background", "session": "follow_up", "session_key": "task", "requires_scene": true, "summary_key": "hostext.event.task.reminder"}
  ],
  "tools": [
    {
      "name": "continue_plan", "kind": "effect", "terminal": "dispatched",
      "lanes": ["background"], "sessions": ["follow_up"], "ports": ["tasks", "journal", "executor"],
      "description_key": "hostext.tool.continue_plan",
      "parameters": {"type": "object", "additionalProperties": false, "required": ["plan_ref"],
        "properties": {"plan_ref": {"type": "string"}, "reply": {"type": "string"}}}
    },
    {
      "name": "describe_capabilities", "kind": "terminal", "terminal": "reply",
      "lanes": ["foreground"], "sessions": ["interactive"], "ports": ["config"],
      "description_key": "hostext.tool.describe_capabilities",
      "parameters": {"type": "object", "additionalProperties": false, "required": ["source_ref", "reply"],
        "properties": {"source_ref": {"type": "string"}, "reply": {"type": "string"}}}
    },
    {
      "name": "scene_config_get", "kind": "read",
      "lanes": ["foreground"], "sessions": ["interactive"], "ports": ["config"],
      "description_key": "hostext.tool.scene_config_get",
      "parameters": {"type": "object", "additionalProperties": false, "required": ["source_ref"],
        "properties": {"source_ref": {"type": "string"}, "section": {"type": "string"}}}
    },
    {
      "name": "create_collection", "kind": "effect", "terminal": "dispatched",
      "lanes": ["foreground"], "sessions": ["interactive"], "ports": ["tasks", "outbox"],
      "description_key": "hostext.tool.create_collection",
      "parameters": {"type": "object", "additionalProperties": false, "required": ["source_ref", "question", "participants"],
        "properties": {"source_ref": {"type": "string"}, "question": {"type": "string"},
          "participants": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "deadline": {"type": "string"}, "reply": {"type": "string"}}}
    },
    {
      "name": "set_scene_participation", "kind": "effect", "terminal": "reply", "exclusive": true,
      "lanes": ["foreground"], "sessions": ["interactive"], "ports": ["config"],
      "description_key": "hostext.tool.set_scene_participation",
      "parameters": {"type": "object", "additionalProperties": false, "required": ["source_ref", "mode", "reply"],
        "properties": {"source_ref": {"type": "string"}, "mode": {"type": "string", "enum": ["active", "quiet"]}, "reply": {"type": "string"}}}
    }
  ]
}
