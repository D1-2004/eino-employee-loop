{
  "version": 1,
  "tools": [
    {
      "name": "reply", "kind": "terminal", "terminal": "reply",
      "lanes": ["foreground", "background"], "ports": ["outbox", "conversation"],
      "description_key": "tool.reply",
      "parameters": {"type": "object", "additionalProperties": false, "required": ["source_ref", "reply"],
        "properties": {"source_ref": {"type": "string"}, "reply": {"type": "string", "minLength": 1}}}
    },
    {
      "name": "stay_quiet", "kind": "terminal", "terminal": "quiet",
      "lanes": ["foreground", "background"], "ports": [],
      "description_key": "tool.stay_quiet",
      "parameters": {"type": "object", "additionalProperties": false, "properties": {"reason": {"type": "string"}}}
    },
    {
      "name": "ask_human", "kind": "effect", "terminal": "waiting",
      "lanes": ["foreground", "background"], "sessions": ["interactive", "follow_up"], "ports": ["outbox", "tasks"],
      "description_key": "tool.ask_human",
      "parameters": {"type": "object", "additionalProperties": false, "required": ["source_ref", "question"],
        "properties": {"source_ref": {"type": "string"}, "question": {"type": "string", "minLength": 1},
          "options": {"type": "array", "items": {"type": "string"}, "maxItems": 8}}}
    },
    {
      "name": "dispatch_task", "kind": "effect", "terminal": "dispatched",
      "lanes": ["foreground"], "sessions": ["interactive"], "ports": ["tasks", "journal", "executor"],
      "description_key": "tool.dispatch_task",
      "parameters": {"type": "object", "additionalProperties": false, "required": ["source_ref", "goal", "prompt"],
        "properties": {"source_ref": {"type": "string"}, "goal": {"type": "string", "minLength": 1},
          "prompt": {"type": "string", "minLength": 1}, "reply": {"type": "string"}}}
    },
    {
      "name": "find_tasks", "kind": "read",
      "lanes": ["foreground"], "ports": ["tasks"],
      "description_key": "tool.find_tasks",
      "parameters": {"type": "object", "additionalProperties": false, "required": ["source_ref"],
        "properties": {"source_ref": {"type": "string"}, "query": {"type": "string"}}}
    },
    {
      "name": "read_task", "kind": "read",
      "lanes": ["foreground", "background"], "ports": ["tasks"],
      "description_key": "tool.read_task",
      "parameters": {"type": "object", "additionalProperties": false, "required": ["source_ref", "task_ref"],
        "properties": {"source_ref": {"type": "string"}, "task_ref": {"type": "string"}}}
    },
    {
      "name": "continue_task", "kind": "effect", "terminal": "dispatched",
      "lanes": ["foreground"], "sessions": ["interactive"], "ports": ["tasks", "journal", "executor"],
      "description_key": "tool.continue_task",
      "parameters": {"type": "object", "additionalProperties": false, "required": ["source_ref", "read_ref", "prompt"],
        "properties": {"source_ref": {"type": "string"}, "read_ref": {"type": "string"}, "prompt": {"type": "string"}, "reply": {"type": "string"}}}
    },
    {
      "name": "steer_task", "kind": "effect", "terminal": "dispatched",
      "lanes": ["foreground"], "sessions": ["interactive"], "ports": ["tasks", "journal", "executor"],
      "description_key": "tool.steer_task",
      "parameters": {"type": "object", "additionalProperties": false, "required": ["source_ref", "correction"],
        "properties": {"source_ref": {"type": "string"}, "task_ref": {"type": "string"}, "correction": {"type": "string"}, "reply": {"type": "string"}}}
    },
    {
      "name": "stop_task", "kind": "effect", "terminal": "reply", "exclusive": true,
      "lanes": ["foreground"], "sessions": ["interactive"], "ports": ["tasks", "journal", "executor"],
      "description_key": "tool.stop_task",
      "parameters": {"type": "object", "additionalProperties": false, "required": ["source_ref", "read_ref", "reply"],
        "properties": {"source_ref": {"type": "string"}, "read_ref": {"type": "string"}, "reply": {"type": "string"}}}
    },
    {
      "name": "memory_capture", "kind": "effect",
      "lanes": ["foreground"], "sessions": ["interactive"], "ports": ["memory"],
      "description_key": "tool.memory_capture",
      "parameters": {"type": "object", "additionalProperties": false, "required": ["source_ref", "audience", "type", "subject", "quote"],
        "properties": {"source_ref": {"type": "string"}, "audience": {"type": "string", "enum": ["me", "scene"]},
          "type": {"type": "string"}, "subject": {"type": "string"}, "quote": {"type": "string"}}}
    },
    {
      "name": "memory_lookup", "kind": "read",
      "lanes": ["foreground", "background"], "ports": ["memory"],
      "description_key": "tool.memory_lookup",
      "parameters": {"type": "object", "additionalProperties": false, "required": ["source_ref", "scope", "query"],
        "properties": {"source_ref": {"type": "string"}, "scope": {"type": "string", "enum": ["me", "scene"]}, "query": {"type": "string"}}}
    },
    {
      "name": "memory_forget", "kind": "effect",
      "lanes": ["foreground"], "sessions": ["interactive"], "ports": ["memory"],
      "description_key": "tool.memory_forget",
      "parameters": {"type": "object", "additionalProperties": false, "required": ["source_ref", "record_ref"],
        "properties": {"source_ref": {"type": "string"}, "record_ref": {"type": "string"}}}
    },
    {
      "name": "read_context", "kind": "read",
      "lanes": ["foreground", "background"], "ports": ["conversation"],
      "description_key": "tool.read_context",
      "parameters": {"type": "object", "additionalProperties": false, "required": ["source_ref", "section"],
        "properties": {"source_ref": {"type": "string"}, "section": {"type": "string", "enum": ["older_conversation"]}}}
    }
  ]
}
